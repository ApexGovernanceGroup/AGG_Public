# Optional production override for the protected Client Services route.
# Prefer hosted secret storage. Do not commit live passwords in .env.local.
CLIENT_SERVICES_PASSWORD=
CLIENT_SERVICES_PASSWORD_SHA256=
CLIENT_SERVICES_SESSION_SECRET=

# Optional server-readable KAIGES|D intake record directory.
# Defaults to .tmp/intake-records and writes JSONL records ignored by Git.
AGG_INTAKE_RECORD_DIR=

# Required to activate live checkout.
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
